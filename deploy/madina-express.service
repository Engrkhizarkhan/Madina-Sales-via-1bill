[Unit]
Description=Madina Express Node.js API (PM2)
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=forking
User=madina-express
Group=madina-express
WorkingDirectory=__PROJECT_DIR__
Environment=PM2_HOME=/var/lib/madina-express/.pm2
Environment=PATH=/opt/node-current/bin:/usr/local/bin:/usr/bin:/bin
PIDFile=/var/lib/madina-express/.pm2/pm2.pid
ExecStart=/opt/node-current/bin/pm2 start __PROJECT_DIR__/deploy/ecosystem.config.cjs --only madina-express --update-env
ExecReload=/opt/node-current/bin/pm2 restart __PROJECT_DIR__/deploy/ecosystem.config.cjs --only madina-express --update-env
ExecStop=/opt/node-current/bin/pm2 kill
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
